# Anki collection data
collection.anki2
collection.media/
collection.media.db2

# Secrets
.bot_config.json
# Backups of the above hold the same secrets (telegram token, anthropic key, api_key)
# but are not covered by the bare filename above — ignore them explicitly.
.bot_config.json.bak-*
.bot_config.json.*.bak
.bot_config.json.tmp

# Python
.venv/
__pycache__/
*.pyc

# JSON snapshots (user data)
json_snapshots/
june_hanly.json

# Collection backups (large .bak files)
backups/

# Large binary corpora (textbooks, graded readers, audio) — keep local only
freq_data/textbooks/
freq_data/books/

# Misc
out.tmp

# Generated corpus intermediates — large & cheap to regenerate, keep local
freq_data/incoming/
freq_data/ocr/
freq_data/chunks/
freq_data/clean/
freq_data/_*.js
freq_data/_*.txt
# (freq_data/banks/ and freq_data/lessons/ are kept: expensive subagent output)

# More secrets / local config
.env
.bot_config_*.json

# Transient SQLite sidecars (like collection.anki2, already ignored above)
collection.anki2-shm
collection.anki2-wal

# The derived read cache. 27.6 MB, rebuilt from the collection in ~3.5s, so it is
# never worth committing or backing up. See READ_CACHE_PLAN.md.
cache.db
cache.db-shm
cache.db-wal

# Session scratch / regenerable analysis caches
freq_data/scratch_queue.json
freq_data/quality/
freq_data/regen/

# Dynamic user lookup logs (grow over time; feed mining)
freq_data/reader_lookups.jsonl

# generated / scratch data from the char-mnemonic + gap + page pipelines (regenerable)
freq_data/chars/
freq_data/gen_fix/
freq_data/gen_gaps/
freq_data/gen/
freq_data/gen_mined/
# gen_coldwindow/ holds the assembled text of a copyrighted novel plus ~33MB of
# cached pages from jjwxc, Douban and other hosts. It is regenerable from the
# scripts and must not reach a remote.
freq_data/gen_coldwindow/
freq_data/ids/
freq_data/mnem_batches_5/
mnem_batches_5/
generated/
quality/
freq_data/hsk3_gap_candidates.json
freq_data/novel_deck_candidates.json
freq_data/hsk_gloss_disagreements.json
freq_data/ingested_reader_ids.json
reading_marks.json
hsk_words_no_mnemonic.json
freq_data/*.bak-*
# personal Hanly dumps (data, not code; cf. june_hanly.json above)
hanly_current.json
hanly_*.json
changelog.jsonl

# Playwright MCP session artefacts (browser console + page dumps). Debris from a
# debugging run, regenerated on demand, never source.
.playwright-mcp/
